# SETUP.bat copies this to ".env" and makes a fresh JWT_SECRET. Every key below is optional.
DATABASE_URL=sqlite:///./cryptosense.db
JWT_SECRET=change-this-to-a-long-random-string
CORS_ORIGINS=*
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT

# Claude (console.anthropic.com) powers Ask Sage when set; Groq below is the fallback (optional)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Free key from console.groq.com makes the Ask Sage chatbot smarter (optional)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

CRYPTOPANIC_KEY=
# Quiver Quantitative (api.quiverquant.com): Congress/insider trades in crypto-linked stocks (optional)
QUIVER_API_KEY=
QUIVER_TICKERS=COIN,MSTR,MARA,RIOT,CLSK,HUT,HOOD,IBIT,FBTC,BITO
WHALE_ALERT_KEY=

# Optional Telegram delivery for this deployment's operator chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LIQUIDATION_ALERT_USD=1000000

# Liquidation intelligence (all optional; defaults shown)
LIQUIDATION_RETENTION_DAYS=7
LIQ_SPIKE_Z=4
LIQ_SPIKE_MIN_USD=250000
LIQ_BASELINE_HOURS=24
LIQ_BURST_EVENTS=15
LIQ_IMBALANCE_SHIFT_PTS=35
LIQ_ALERT_COOLDOWN_MINUTES=30
