<mxfile host="app.diagrams.net" type="device"><diagram name="Machine Learning Pipeline" id="11_ml_pipeline"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="1. Download Binance hourly candles (up to 10 years)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="250" height="90" as="geometry"/></mxCell><mxCell id="c2" value="2. Download futures funding + Fear &amp;amp; Greed history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="40" width="250" height="90" as="geometry"/></mxCell><mxCell id="c3" value="3. Keep only hours with real funding and Fear &amp;amp; Greed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="40" width="250" height="90" as="geometry"/></mxCell><mxCell id="c4" value="4. Feature engineering: 18 features (technical, order flow, context)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="40" width="250" height="90" as="geometry"/></mxCell><mxCell id="c5" value="5. Label: price 24 h later vs ±2.5% (bearish / neutral / bullish)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="40" width="250" height="90" as="geometry"/></mxCell><mxCell id="c6" value="6. Chronological split 70 / 15 / 15 per coin with 24 h gaps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="240" width="250" height="90" as="geometry"/></mxCell><mxCel