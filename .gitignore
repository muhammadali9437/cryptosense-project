# Secrets and local environment files. Keep example templates tracked.
**/.env
**/.env.*
!**/.env.example

# Local data and generated/runtime artifacts
*.db
*.sqlite
*.sqlite3
backend/rag_store/*
!backend/rag_store/.gitkeep
**/venv/
**/.venv/
**/__pycache__/
*.py[cod]
*.joblib
*.pt
*.pth
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Flutter/Dart generated files; keep frontend/web source files.
frontend/build/
frontend/.dart_tool/
frontend/.flutter-plugins-dependencies
frontend/.idea/
frontend/.pub-cache/
frontend/.packages
frontend/coverage/

# Local editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
backend/ml/backtest_results/
